# Domaine principal, utilisé pour le dashboard traefik.astucom.com
DOMAIN=astucom.com

# Auth basique du dashboard : génère avec `htpasswd -nb admin tonmotdepasse`
# Important: les $ doivent être doublés ($$) dans le .env, sinon docker compose les interprète mal
DASHBOARD_AUTH=admin:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxxx
